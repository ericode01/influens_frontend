# Copy this file to .env and fill in your own values. Never commit .env.

# Random string used to sign sessions. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Backend base URLs (include the trailing slash)
PROD=false
LOCAL_HOST=http://127.0.0.1:5000/
PROD_INFLUENS_BACKEND=https://your-backend.example.com/

# OAuth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
